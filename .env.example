# ==================== UYGULAMA AYARLARI ====================
# Uygulama adı
APP_NAME=CookWise API

# Uygulama ortamı: development, staging, production
APP_ENV=development

# Sunucunun çalışacağı host
APP_HOST=0.0.0.0

# Sunucunun dinleyeceği port
APP_PORT=8000

# ==================== MONGODB AYARLARI ====================
# MongoDB bağlantı string'i
# Local: mongodb://localhost:27017
# Docker: mongodb://mongodb:27017
# Alaca: mongodb+srv://username:password@cluster.mongodb.net
MONGODB_URL=mongodb://localhost:27017

# Kullanılacak veritabanı adı
MONGODB_DB=cookwise

# ==================== JWT (JSON Web Token) AYARLARI ====================
# JWT token'ları imzalamak için gizli anahtar
# ÖNEMLI: Production'da çok güçlü ve random bir key kullan!
# Örnek oluştur: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-min-32-chars-change-in-production

# JWT imzalama algoritması
ALGORITHM=HS256

# Access token'ın geçerlilik süresi (dakika)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== CORS AYARLARI ====================
# CORS'ta izin verilecek origin'ler (virgülle ayrılmış)
# Development: "*" (hepsi)
# Production: ["http://localhost:3000", "https://example.com"]
CORS_ORIGINS=["*"]

# ==================== FIREBASE (Kullanıcılar için - Opsiyonel) ====================
# True yaparsanız kullanıcılar Firebase'de tutulur (Auth + Firestore)
# USE_FIREBASE_AUTH=True
# Service Account JSON dosya yolu (Firebase Console -> Project Settings -> Service Accounts)
# FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# Firebase proje ID
# FIREBASE_PROJECT_ID=cookwise-xxxxx
# Web API Key (Firebase Console -> Project Settings -> General) - Login için gerekli
# FIREBASE_API_KEY=AIzaSy...

ADMIN_EMAILS=["admin@cookwise.com"]

# ==================== DEBUG MODU ====================
# Debug modu: True (dev), False (production)
DEBUG=True

# ==================== AI PROVIDER ====================
# AI Provider: gemini, openai, local
AI_PROVIDER=gemini

# Gemini API Key (google-generativeai)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (opsiyonel)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==================== RECIPE DATASET ====================
RECIPES_DATASET_PATH=recipes.json
CLEANED_RECIPES_PATH=cleaned_recipes.json
